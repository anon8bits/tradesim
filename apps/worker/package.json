{
  "name": "@tradesim/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch --tsconfig ../../tsconfig.base.json src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "pretest": "pnpm --filter @tradesim/common build && pnpm --filter @tradesim/db build",
    "test": "dotenv -e ../../.env -- jest --runInBand",
    "test:concurrency": "dotenv -e ../../.env -- jest --runInBand src/execution/concurrency.spec.ts"
  },
  "dependencies": {
    "@tradesim/common": "workspace:*",
    "@tradesim/db": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0"
  }
}
