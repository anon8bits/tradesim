# Copy to apps/web/.env.local and fill in. Never commit the real file.

# "mock" runs the whole UI against an in-browser fake API and a fake signed-in
# user (no Auth0, API, or worker needed). "live" talks to apps/api.
VITE_API_MODE=mock

# Live mode: API base URL. In dev, "/api" is proxied to http://localhost:3000
# by vite.config.ts (override the target with VITE_DEV_API_TARGET).
VITE_API_BASE_URL=/api

# Live mode: Auth0 Single Page Application settings.
# Domain and audience must match the API's AUTH0_DOMAIN / AUTH0_AUDIENCE.
# In the Auth0 SPA app, allow:
#   Callback URLs:      http://localhost:5173/app
#   Logout URLs:        http://localhost:5173
#   Web Origins:        http://localhost:5173
# and enable Refresh Token Rotation (plus "Allow Offline Access" on the API).
VITE_AUTH0_DOMAIN=dev-igqjd2dbnlcr71c4.us.auth0.com
VITE_AUTH0_CLIENT_ID=fzB1GhgsRw6s9j63npexELX74CGW3ImI
VITE_AUTH0_AUDIENCE=t9b92Evn-EF-0an6sC3yBGf6rS2UTfJzq_eTRTPDEzo_BtVitCs_tFw_y8kHlg15
